rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isParticipant(conversationId) {
      return isAuthenticated() &&
        request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
    }

    function getConversation(conversationId) {
      return get(/databases/$(database)/documents/conversations/$(conversationId)).data;
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Users Collection
    match /users/{userId} {
      // Authenticated users can view user profiles for user discovery
      allow read: if isAuthenticated();

      // Only the user themselves can create their profile document
      allow create: if isOwner(userId)
                    && request.resource.data.email is string
                    && request.resource.data.name is string;

      // Only the user themselves can update their profile; cannot alter protected fields
      allow update: if isOwner(userId)
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['email', 'createdAt', 'provider']));

      // Only the user themselves can delete their own profile
      allow delete: if isOwner(userId);

      // User Private FCM Tokens Subcollection
      // STRICT PRIVACY: Only the device owner can read/write their own tokens
      match /fcmTokens/{tokenId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Conversations Collection
    match /conversations/{conversationId} {
      // Must be an active participant to read the conversation
      allow read: if isAuthenticated() && request.auth.uid in resource.data.participantIds;

      // Creation rules:
      // Direct: exactly 2 participants, deterministic ID, createdBy is auth user
      // Group: at least 2 participants, createdBy is auth user and admin
      allow create: if isAuthenticated()
                    && request.auth.uid in request.resource.data.participantIds
                    && request.resource.data.createdBy == request.auth.uid
                    && (
                      (
                        request.resource.data.type == 'direct'
                        && request.resource.data.participantIds.size() == 2
                      ) || (
                        request.resource.data.type == 'group'
                        && request.resource.data.participantIds.size() >= 2
                        && request.auth.uid in request.resource.data.adminIds
                        && request.resource.data.groupName is string
                        && request.resource.data.groupName.size() > 0
                        && request.resource.data.groupName.size() <= 100
                      )
                    );

      // Update rules:
      // Prevent tampering with immutable conversation fields (createdBy, type, createdAt)
      // For Direct: participantIds cannot change
      // For Group: only admins can modify groupName, groupAvatar, adminIds, or participantIds
      // Participants can only update preview fields and their own read timestamp
      allow update: if isAuthenticated()
                    && request.auth.uid in resource.data.participantIds
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['createdBy', 'type', 'createdAt']))
                    && (
                      // Direct conversation updates: participants immutable
                      (
                        resource.data.type == 'direct'
                        && request.resource.data.participantIds == resource.data.participantIds
                      ) || (
                        // Group conversation updates:
                        resource.data.type == 'group'
                        && (
                          // If non-admin, cannot change adminIds, participantIds, groupName, groupAvatar
                          request.auth.uid in resource.data.adminIds
                          || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['adminIds', 'participantIds', 'groupName', 'groupAvatar'])
                        )
                      )
                    )
                    && (
                      !request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastReadAtByUser'])
                      || (!('lastReadAtByUser' in resource.data)
                          ? request.resource.data.lastReadAtByUser.keys().hasOnly([request.auth.uid])
                          : request.resource.data.lastReadAtByUser.diff(resource.data.lastReadAtByUser).affectedKeys().hasOnly([request.auth.uid]))
                    );

      // Deletion allowed only for creator or group admin
      allow delete: if isAuthenticated()
                    && (
                      request.auth.uid == resource.data.createdBy
                      || (resource.data.type == 'group' && request.auth.uid in resource.data.adminIds)
                    );

      // Messages Subcollection
      match /messages/{messageId} {
        // Can read if participant in the parent conversation
        allow read: if isParticipant(conversationId);

        // Can create message if participant, senderId matches auth.uid, and text meets constraints
        allow create: if isParticipant(conversationId)
                      && request.resource.data.senderId == request.auth.uid
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 2000;

        // Retroactive edits: only sender can edit text; cannot alter senderId or createdAt
        allow update: if isParticipant(conversationId)
                      && resource.data.senderId == request.auth.uid
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 2000
                      && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['senderId', 'createdAt']));

        // Deletion: only sender or conversation admin
        allow delete: if isParticipant(conversationId)
                      && (
                        resource.data.senderId == request.auth.uid
                        || request.auth.uid in getConversation(conversationId).adminIds
                      );
      }
    }
  }
}
